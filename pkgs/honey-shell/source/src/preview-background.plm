// Only used by the isolated preview, never applied as the desktop wallpaper.
scene PreviewBackground {
    surface backdrop {
        size: full, full; anchor: top; level: background; keyboard: none
        box { from: 0, 0; size: backdrop.width, backdrop.height; color: #292b29 }
        ellipse { at: backdrop.width * 0.15, backdrop.height * 1.1; radius: backdrop.width * 0.65; scale: 1, 0.5; color: #414137 }
        ellipse { at: backdrop.width * 0.9, backdrop.height * 1.15; radius: backdrop.width * 0.65; scale: 1, 0.55; color: #343c34 }
        repeat i in 0..12 {
            line { from: i * backdrop.width / 12, 0; to: i * backdrop.width / 12, backdrop.height; width: 1; color: #ffffff; opacity: .025 }
        }
        zone box probe { from: 60, 450; size: 120, 120 }
        on press probe { emit background_probe }
        event background_probe ->
        text "HONEY / PLEAMAR" { family: "Fredoka"; at: backdrop.width * .5, backdrop.height * .78; anchor: center; size: 30; weight: 600; color: #e3d5b2; opacity: .5 }
        text "Sessão de teste isolada" { family: "Nunito"; at: backdrop.width * .5, backdrop.height * .82; anchor: center; size: 15; weight: 600; color: #e3d5b2; opacity: .4 }
    }
}
