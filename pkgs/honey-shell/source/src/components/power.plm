library PowerPanelLibrary {
    component PowerPanel {
    group { opacity: 1; show: poweron
    prop hot = 0 ~quick
    follow hot = if(power_hit.hover, 1, 0)
    on change hot { powerhot = hot }

        zone box power_body { from: pwx, 0; size: pww, pwh; active: panel == 4 }
        zone box power_hit { from: rightx, 0; size: 44, 38; cursor: pointer; active: panel != 4 }
        on press power_hit { emit request(4) }
        figure power { at: rightx + 22, 22; size: 20, 20; color: ink }
        group { opacity: clamp((power - 0.6) / 0.4, 0, 1)
            zone box power_inside { from: rightx - 90, 40; size: if(compact, 178, 245), 310 }
            text "Sessão" { family: "Fredoka"; anchor: left center; at: rightx - 70, 78; size: 23; weight: 600; color: ink }
            repeat i in 0..5 {
                Gob(rightx - 74, 98 + i * 41, if(compact, 155, 210), 34, power.$i.hover, if(confirm == i + 1, 1, 0), i)
                zone box power.$i { from: rightx - 74, 98 + i * 41; size: if(compact, 155, 210), 34; cursor: pointer }
                on press power.$i { emit power_action(i) }
            }
            figure lock { at: rightx - 55, 116; size: 18, 18; color: ink }
            figure moon { at: rightx - 55, 157; size: 18, 18; color: ink }
            figure logout { at: rightx - 55, 198; size: 18, 18; color: ink }
            figure restart { at: rightx - 55, 239; size: 18, 18; color: ink }
            figure power { at: rightx - 55, 280; size: 18, 18; color: ink }
            text "Bloquear" { family: "Nunito"; anchor: left center; at: rightx - 30, 121; size: 13; weight: 600; color: ink }
            text "Suspender" { family: "Nunito"; anchor: left center; at: rightx - 30, 162; size: 13; weight: 600; color: ink }
            text "Sair da sessão" { family: "Nunito"; anchor: left center; at: rightx - 30, 203; size: 13; weight: 600; color: ink }
            text "Reiniciar" { family: "Nunito"; anchor: left center; at: rightx - 30, 244; size: 13; weight: 600; color: ink }
            text "Desligar" { family: "Nunito"; anchor: left center; at: rightx - 30, 285; size: 13; weight: 600; color: ink }
            text "Clique novamente para confirmar" { family: "Nunito"; anchor: left center; at: rightx - 73, 326; size: 11; weight: 600; width: if(compact, 155, 210); lines: 2; color: ink; show: confirm > 0 }
        }
    }
    }
}
