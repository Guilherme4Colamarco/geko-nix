library CavaPanelLibrary {
    component CavaPanel {
    group {
        opacity: 1; show: cavaon
    prop hot = 0 ~quick
    follow hot = if(cava_hit.hover, 1, 0)

        Honey(12, if(compact, 88, 180) + media * if(compact, 192, 100), 42 + media * 190, media * deform + audioflow + hot * 0.15 * deform)
        zone box cava_hit { from: 12, 0; size: if(compact, 88, 180) + media * if(compact, 192, 100), 42 + media * 190; cursor: pointer }
        on press cava_hit { emit request(5) }
        for b in bands {
            box { from: 28 + b.index * if(compact, 5, 12), 29 - b.level * 20; size: if(compact, 3, 7), 6 + b.level * 20; corner: 3; color: ink; opacity: 0.7 }
        }
        group { opacity: clamp((media - 0.6) / 0.4, 0, 1)
            text mediastatus { family: "DejaVu Sans"; anchor: left center; at: 34, 78; size: 16; color: ink; width: 235; lines: 2 }
            text "O mel acompanha o áudio" { family: "DejaVu Sans"; anchor: left center; at: 34, 140; size: 12; color: ink; width: 230 }
            text backend { family: "DejaVu Sans"; anchor: left center; at: 34, 176; size: 10; color: ink }
        }
    }
    }
}
