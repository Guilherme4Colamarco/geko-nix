library CavaPanelLibrary {
    component CavaPanel {
    group {
    prop hot = 0 ~quick
    follow hot = if(cava_hit.hover, 1, 0)
    on change hot { cavahot = hot }
        opacity: 1; show: cavaon

        zone box cava_hit { from: cavx, 0; size: cavw, cavh; cursor: pointer }
        on press cava_hit { emit request(5) }
        let step = if(compact, 5, 12)
        let rad = if(compact, 1.7, 3.4)
        let bx = 31
        let base = 28
        body {
            color: ink; opacity: 0.7
            rim: 6.000%; light: 0.3, 0.1, 0.7
            ellipse { at: bx + 0*step, base - bands.0.level * 17; radius: rad + bands.0.level * 1.5; scale: 1, 1 + bands.0.level * 1.3; blend: 9 }
            ellipse { at: bx + 1*step, base - bands.1.level * 17; radius: rad + bands.1.level * 1.5; scale: 1, 1 + bands.1.level * 1.3; blend: 9 }
            ellipse { at: bx + 2*step, base - bands.2.level * 17; radius: rad + bands.2.level * 1.5; scale: 1, 1 + bands.2.level * 1.3; blend: 9 }
            ellipse { at: bx + 3*step, base - bands.3.level * 17; radius: rad + bands.3.level * 1.5; scale: 1, 1 + bands.3.level * 1.3; blend: 9 }
            ellipse { at: bx + 4*step, base - bands.4.level * 17; radius: rad + bands.4.level * 1.5; scale: 1, 1 + bands.4.level * 1.3; blend: 9 }
            ellipse { at: bx + 5*step, base - bands.5.level * 17; radius: rad + bands.5.level * 1.5; scale: 1, 1 + bands.5.level * 1.3; blend: 9 }
            ellipse { at: bx + 6*step, base - bands.6.level * 17; radius: rad + bands.6.level * 1.5; scale: 1, 1 + bands.6.level * 1.3; blend: 9 }
            ellipse { at: bx + 7*step, base - bands.7.level * 17; radius: rad + bands.7.level * 1.5; scale: 1, 1 + bands.7.level * 1.3; blend: 9 }
            ellipse { at: bx + 8*step, base - bands.8.level * 17; radius: rad + bands.8.level * 1.5; scale: 1, 1 + bands.8.level * 1.3; blend: 9 }
            ellipse { at: bx + 9*step, base - bands.9.level * 17; radius: rad + bands.9.level * 1.5; scale: 1, 1 + bands.9.level * 1.3; blend: 9 }
            ellipse { at: bx + 10*step, base - bands.10.level * 17; radius: rad + bands.10.level * 1.5; scale: 1, 1 + bands.10.level * 1.3; blend: 9 }
            ellipse { at: bx + 11*step, base - bands.11.level * 17; radius: rad + bands.11.level * 1.5; scale: 1, 1 + bands.11.level * 1.3; blend: 9 }
        }
        group { opacity: clamp((media - 0.6) / 0.4, 0, 1)
            text mediastatus { family: "Nunito"; anchor: left center; at: 34, 78; size: 17; weight: 600; color: ink; width: 235; lines: 2 }
            text "O mel acompanha o áudio" { family: "Nunito"; anchor: left center; at: 34, 140; size: 13; weight: 600; color: ink; width: 230 }
            text backend { family: "Nunito"; anchor: left center; at: 34, 176; size: 11; weight: 600; color: ink }
        }
    }
    }
}
