library Results {
    component Result(h: record, width: number) {
        size: width, 40
        Gob(0, 0, width, 40, hit.hover * 0.5, if(sel == h.index, 1, 0), h.index)
        zone box hit { from: 0, 0; size: width, 40; cursor: pointer }
        text h.name { family: "Nunito"; anchor: left center; at: 48, 16; size: 15; weight: 700; width: width - 145; lines: 1; color: if(sel == h.index, darkink, ink) }
        text h.detail { family: "Nunito"; anchor: left center; at: 48, 32; size: 11; weight: 600; width: width - 145; lines: 1; color: if(sel == h.index, darkink, ink); opacity: 0.75 }
        image h.icon { at: 12, 8; size: 24, 24 }
        image h.preview { at: width - 83, 3; size: 70, 34 }
        on enter hit { sel = h.index }
        on press hit { emit activate(h.index) }
    }
}
