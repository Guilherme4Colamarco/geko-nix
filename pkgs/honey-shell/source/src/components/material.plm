library HoneyMaterial {
    // ONE body for the whole top strip: panels are boxes with lumps along their
    // bottom edge, and `blend` lets neighbours melt into each other. When a menu
    // grows and meets another drop, a bridge drop swells between them and they
    // become a single mass. Closed paths are far too slow here (see docs/honey.md).
    component HoneyTop(cavx: number, cavw: number, cavh: number, cavm: number, ctlx: number, ctlw: number, ctlh: number, ctlm: number, cenx: number, cenw: number, cenh: number, cenm: number, trpx: number, trpw: number, trph: number, trpm: number, pwx: number, pww: number, pwh: number, pwm: number, ntx: number, nty: number, ntw: number, nth: number, ntg: number, nn0: number, nn1: number, nn2: number, nl0: number, nl1: number, nl2: number, nunread: number, nbx: number, nby: number) {
        let t = time * 0.35
        body {
            color: honey; opacity: tint
            glass: glassiness; lens: frost; refraction: refract * thickness
            dispersion: dispersion; dome: dome * thickness; ripple: ripple * deform
            rim: 8.000%; light: 0.2, 0.2, 0.6
            shadow: 0, 3, 8, shade
            box { from: cavx, -30; size: cavw, cavh + 24; corner: roundness * 0.8; blend: 8; show: cavaon }
            ellipse { at: cavx + cavw * (0.16 + noise(0 + 7, 3) * 0.07) + noise(0, t) * 5 * life, cavh - 7 + (noise(0 + 11, 3) * 0.5 + 0.5) * 11 + noise(0 + 3, t * 1.3) * 3 * life + abs(cavm) * 5; radius: (9 + (noise(0 + 3, 5) * 0.5 + 0.5) * 9) * thickness * clamp(cavw / 180, 0.5, 1.2); scale: 1, 0.8 + abs(cavm) * 0.3 + noise(0 + 5, t * 1.1) * 0.1 * life; blend: 18; show: cavaon }
            ellipse { at: cavx + cavw * (0.33 + noise(1 + 7, 3) * 0.07) + noise(1, t) * 5 * life, cavh - 7 + (noise(1 + 11, 3) * 0.5 + 0.5) * 11 + noise(1 + 3, t * 1.3) * 3 * life + abs(cavm) * 6; radius: (9 + (noise(1 + 3, 5) * 0.5 + 0.5) * 9) * thickness * clamp(cavw / 180, 0.5, 1.2); scale: 1, 0.8 + abs(cavm) * 0.3 + noise(1 + 5, t * 1.1) * 0.1 * life; blend: 18; show: cavaon }
            ellipse { at: cavx + cavw * (0.50 + noise(2 + 7, 3) * 0.07) + noise(2, t) * 5 * life, cavh - 7 + (noise(2 + 11, 3) * 0.5 + 0.5) * 11 + noise(2 + 3, t * 1.3) * 3 * life + abs(cavm) * 7; radius: (9 + (noise(2 + 3, 5) * 0.5 + 0.5) * 9) * thickness * clamp(cavw / 180, 0.5, 1.2); scale: 1, 0.8 + abs(cavm) * 0.3 + noise(2 + 5, t * 1.1) * 0.1 * life; blend: 18; show: cavaon }
            ellipse { at: cavx + cavw * (0.67 + noise(3 + 7, 3) * 0.07) + noise(3, t) * 5 * life, cavh - 7 + (noise(3 + 11, 3) * 0.5 + 0.5) * 11 + noise(3 + 3, t * 1.3) * 3 * life + abs(cavm) * 8; radius: (9 + (noise(3 + 3, 5) * 0.5 + 0.5) * 9) * thickness * clamp(cavw / 180, 0.5, 1.2); scale: 1, 0.8 + abs(cavm) * 0.3 + noise(3 + 5, t * 1.1) * 0.1 * life; blend: 18; show: cavaon }
            ellipse { at: cavx + cavw * (0.84 + noise(4 + 7, 3) * 0.07) + noise(4, t) * 5 * life, cavh - 7 + (noise(4 + 11, 3) * 0.5 + 0.5) * 11 + noise(4 + 3, t * 1.3) * 3 * life + abs(cavm) * 9; radius: (9 + (noise(4 + 3, 5) * 0.5 + 0.5) * 9) * thickness * clamp(cavw / 180, 0.5, 1.2); scale: 1, 0.8 + abs(cavm) * 0.3 + noise(4 + 5, t * 1.1) * 0.1 * life; blend: 18; show: cavaon }
            box { from: ctlx, -30; size: ctlw, ctlh + 24; corner: roundness * 0.8; blend: 8; show: controlson }
            ellipse { at: ctlx + ctlw * (0.16 + noise(20 + 7, 3) * 0.07) + noise(20, t) * 5 * life, ctlh - 7 + (noise(20 + 11, 3) * 0.5 + 0.5) * 11 + noise(20 + 3, t * 1.3) * 3 * life + abs(ctlm) * 5; radius: (9 + (noise(20 + 3, 5) * 0.5 + 0.5) * 9) * thickness * clamp(ctlw / 180, 0.5, 1.2); scale: 1, 0.8 + abs(ctlm) * 0.3 + noise(20 + 5, t * 1.1) * 0.1 * life; blend: 18; show: controlson }
            ellipse { at: ctlx + ctlw * (0.33 + noise(21 + 7, 3) * 0.07) + noise(21, t) * 5 * life, ctlh - 7 + (noise(21 + 11, 3) * 0.5 + 0.5) * 11 + noise(21 + 3, t * 1.3) * 3 * life + abs(ctlm) * 6; radius: (9 + (noise(21 + 3, 5) * 0.5 + 0.5) * 9) * thickness * clamp(ctlw / 180, 0.5, 1.2); scale: 1, 0.8 + abs(ctlm) * 0.3 + noise(21 + 5, t * 1.1) * 0.1 * life; blend: 18; show: controlson }
            ellipse { at: ctlx + ctlw * (0.50 + noise(22 + 7, 3) * 0.07) + noise(22, t) * 5 * life, ctlh - 7 + (noise(22 + 11, 3) * 0.5 + 0.5) * 11 + noise(22 + 3, t * 1.3) * 3 * life + abs(ctlm) * 7; radius: (9 + (noise(22 + 3, 5) * 0.5 + 0.5) * 9) * thickness * clamp(ctlw / 180, 0.5, 1.2); scale: 1, 0.8 + abs(ctlm) * 0.3 + noise(22 + 5, t * 1.1) * 0.1 * life; blend: 18; show: controlson }
            ellipse { at: ctlx + ctlw * (0.67 + noise(23 + 7, 3) * 0.07) + noise(23, t) * 5 * life, ctlh - 7 + (noise(23 + 11, 3) * 0.5 + 0.5) * 11 + noise(23 + 3, t * 1.3) * 3 * life + abs(ctlm) * 8; radius: (9 + (noise(23 + 3, 5) * 0.5 + 0.5) * 9) * thickness * clamp(ctlw / 180, 0.5, 1.2); scale: 1, 0.8 + abs(ctlm) * 0.3 + noise(23 + 5, t * 1.1) * 0.1 * life; blend: 18; show: controlson }
            ellipse { at: ctlx + ctlw * (0.84 + noise(24 + 7, 3) * 0.07) + noise(24, t) * 5 * life, ctlh - 7 + (noise(24 + 11, 3) * 0.5 + 0.5) * 11 + noise(24 + 3, t * 1.3) * 3 * life + abs(ctlm) * 9; radius: (9 + (noise(24 + 3, 5) * 0.5 + 0.5) * 9) * thickness * clamp(ctlw / 180, 0.5, 1.2); scale: 1, 0.8 + abs(ctlm) * 0.3 + noise(24 + 5, t * 1.1) * 0.1 * life; blend: 18; show: controlson }
            box { from: cenx, -30; size: cenw, cenh + 24; corner: roundness * 0.8; blend: 8; show: true }
            ellipse { at: cenx + cenw * (0.16 + noise(40 + 7, 3) * 0.07) + noise(40, t) * 5 * life, cenh - 7 + (noise(40 + 11, 3) * 0.5 + 0.5) * 11 + noise(40 + 3, t * 1.3) * 3 * life + abs(cenm) * 5; radius: (9 + (noise(40 + 3, 5) * 0.5 + 0.5) * 9) * thickness * clamp(cenw / 180, 0.5, 1.2); scale: 1, 0.8 + abs(cenm) * 0.3 + noise(40 + 5, t * 1.1) * 0.1 * life; blend: 18; show: true }
            ellipse { at: cenx + cenw * (0.33 + noise(41 + 7, 3) * 0.07) + noise(41, t) * 5 * life, cenh - 7 + (noise(41 + 11, 3) * 0.5 + 0.5) * 11 + noise(41 + 3, t * 1.3) * 3 * life + abs(cenm) * 6; radius: (9 + (noise(41 + 3, 5) * 0.5 + 0.5) * 9) * thickness * clamp(cenw / 180, 0.5, 1.2); scale: 1, 0.8 + abs(cenm) * 0.3 + noise(41 + 5, t * 1.1) * 0.1 * life; blend: 18; show: true }
            ellipse { at: cenx + cenw * (0.50 + noise(42 + 7, 3) * 0.07) + noise(42, t) * 5 * life, cenh - 7 + (noise(42 + 11, 3) * 0.5 + 0.5) * 11 + noise(42 + 3, t * 1.3) * 3 * life + abs(cenm) * 7; radius: (9 + (noise(42 + 3, 5) * 0.5 + 0.5) * 9) * thickness * clamp(cenw / 180, 0.5, 1.2); scale: 1, 0.8 + abs(cenm) * 0.3 + noise(42 + 5, t * 1.1) * 0.1 * life; blend: 18; show: true }
            ellipse { at: cenx + cenw * (0.67 + noise(43 + 7, 3) * 0.07) + noise(43, t) * 5 * life, cenh - 7 + (noise(43 + 11, 3) * 0.5 + 0.5) * 11 + noise(43 + 3, t * 1.3) * 3 * life + abs(cenm) * 8; radius: (9 + (noise(43 + 3, 5) * 0.5 + 0.5) * 9) * thickness * clamp(cenw / 180, 0.5, 1.2); scale: 1, 0.8 + abs(cenm) * 0.3 + noise(43 + 5, t * 1.1) * 0.1 * life; blend: 18; show: true }
            ellipse { at: cenx + cenw * (0.84 + noise(44 + 7, 3) * 0.07) + noise(44, t) * 5 * life, cenh - 7 + (noise(44 + 11, 3) * 0.5 + 0.5) * 11 + noise(44 + 3, t * 1.3) * 3 * life + abs(cenm) * 9; radius: (9 + (noise(44 + 3, 5) * 0.5 + 0.5) * 9) * thickness * clamp(cenw / 180, 0.5, 1.2); scale: 1, 0.8 + abs(cenm) * 0.3 + noise(44 + 5, t * 1.1) * 0.1 * life; blend: 18; show: true }
            box { from: trpx, -30; size: trpw, trph + 24; corner: roundness * 0.8; blend: 8; show: trayon }
            ellipse { at: trpx + trpw * (0.16 + noise(60 + 7, 3) * 0.07) + noise(60, t) * 5 * life, trph - 7 + (noise(60 + 11, 3) * 0.5 + 0.5) * 11 + noise(60 + 3, t * 1.3) * 3 * life + abs(trpm) * 5; radius: (9 + (noise(60 + 3, 5) * 0.5 + 0.5) * 9) * thickness * clamp(trpw / 180, 0.5, 1.2); scale: 1, 0.8 + abs(trpm) * 0.3 + noise(60 + 5, t * 1.1) * 0.1 * life; blend: 18; show: trayon }
            ellipse { at: trpx + trpw * (0.33 + noise(61 + 7, 3) * 0.07) + noise(61, t) * 5 * life, trph - 7 + (noise(61 + 11, 3) * 0.5 + 0.5) * 11 + noise(61 + 3, t * 1.3) * 3 * life + abs(trpm) * 6; radius: (9 + (noise(61 + 3, 5) * 0.5 + 0.5) * 9) * thickness * clamp(trpw / 180, 0.5, 1.2); scale: 1, 0.8 + abs(trpm) * 0.3 + noise(61 + 5, t * 1.1) * 0.1 * life; blend: 18; show: trayon }
            ellipse { at: trpx + trpw * (0.50 + noise(62 + 7, 3) * 0.07) + noise(62, t) * 5 * life, trph - 7 + (noise(62 + 11, 3) * 0.5 + 0.5) * 11 + noise(62 + 3, t * 1.3) * 3 * life + abs(trpm) * 7; radius: (9 + (noise(62 + 3, 5) * 0.5 + 0.5) * 9) * thickness * clamp(trpw / 180, 0.5, 1.2); scale: 1, 0.8 + abs(trpm) * 0.3 + noise(62 + 5, t * 1.1) * 0.1 * life; blend: 18; show: trayon }
            ellipse { at: trpx + trpw * (0.67 + noise(63 + 7, 3) * 0.07) + noise(63, t) * 5 * life, trph - 7 + (noise(63 + 11, 3) * 0.5 + 0.5) * 11 + noise(63 + 3, t * 1.3) * 3 * life + abs(trpm) * 8; radius: (9 + (noise(63 + 3, 5) * 0.5 + 0.5) * 9) * thickness * clamp(trpw / 180, 0.5, 1.2); scale: 1, 0.8 + abs(trpm) * 0.3 + noise(63 + 5, t * 1.1) * 0.1 * life; blend: 18; show: trayon }
            ellipse { at: trpx + trpw * (0.84 + noise(64 + 7, 3) * 0.07) + noise(64, t) * 5 * life, trph - 7 + (noise(64 + 11, 3) * 0.5 + 0.5) * 11 + noise(64 + 3, t * 1.3) * 3 * life + abs(trpm) * 9; radius: (9 + (noise(64 + 3, 5) * 0.5 + 0.5) * 9) * thickness * clamp(trpw / 180, 0.5, 1.2); scale: 1, 0.8 + abs(trpm) * 0.3 + noise(64 + 5, t * 1.1) * 0.1 * life; blend: 18; show: trayon }
            box { from: pwx, -30; size: pww, pwh + 24; corner: roundness * 0.8; blend: 8; show: poweron }
            ellipse { at: pwx + pww * (0.16 + noise(80 + 7, 3) * 0.07) + noise(80, t) * 5 * life, pwh - 7 + (noise(80 + 11, 3) * 0.5 + 0.5) * 11 + noise(80 + 3, t * 1.3) * 3 * life + abs(pwm) * 5; radius: (9 + (noise(80 + 3, 5) * 0.5 + 0.5) * 9) * thickness * clamp(pww / 180, 0.5, 1.2); scale: 1, 0.8 + abs(pwm) * 0.3 + noise(80 + 5, t * 1.1) * 0.1 * life; blend: 18; show: poweron }
            ellipse { at: pwx + pww * (0.33 + noise(81 + 7, 3) * 0.07) + noise(81, t) * 5 * life, pwh - 7 + (noise(81 + 11, 3) * 0.5 + 0.5) * 11 + noise(81 + 3, t * 1.3) * 3 * life + abs(pwm) * 6; radius: (9 + (noise(81 + 3, 5) * 0.5 + 0.5) * 9) * thickness * clamp(pww / 180, 0.5, 1.2); scale: 1, 0.8 + abs(pwm) * 0.3 + noise(81 + 5, t * 1.1) * 0.1 * life; blend: 18; show: poweron }
            ellipse { at: pwx + pww * (0.50 + noise(82 + 7, 3) * 0.07) + noise(82, t) * 5 * life, pwh - 7 + (noise(82 + 11, 3) * 0.5 + 0.5) * 11 + noise(82 + 3, t * 1.3) * 3 * life + abs(pwm) * 7; radius: (9 + (noise(82 + 3, 5) * 0.5 + 0.5) * 9) * thickness * clamp(pww / 180, 0.5, 1.2); scale: 1, 0.8 + abs(pwm) * 0.3 + noise(82 + 5, t * 1.1) * 0.1 * life; blend: 18; show: poweron }
            ellipse { at: pwx + pww * (0.67 + noise(83 + 7, 3) * 0.07) + noise(83, t) * 5 * life, pwh - 7 + (noise(83 + 11, 3) * 0.5 + 0.5) * 11 + noise(83 + 3, t * 1.3) * 3 * life + abs(pwm) * 8; radius: (9 + (noise(83 + 3, 5) * 0.5 + 0.5) * 9) * thickness * clamp(pww / 180, 0.5, 1.2); scale: 1, 0.8 + abs(pwm) * 0.3 + noise(83 + 5, t * 1.1) * 0.1 * life; blend: 18; show: poweron }
            ellipse { at: pwx + pww * (0.84 + noise(84 + 7, 3) * 0.07) + noise(84, t) * 5 * life, pwh - 7 + (noise(84 + 11, 3) * 0.5 + 0.5) * 11 + noise(84 + 3, t * 1.3) * 3 * life + abs(pwm) * 9; radius: (9 + (noise(84 + 3, 5) * 0.5 + 0.5) * 9) * thickness * clamp(pww / 180, 0.5, 1.2); scale: 1, 0.8 + abs(pwm) * 0.3 + noise(84 + 5, t * 1.1) * 0.1 * life; blend: 18; show: poweron }
            ellipse { at: (cavx + cavw + ctlx) * 0.5, min(cavh, ctlh) * 0.5; radius: 6 + clamp(1 - (ctlx - cavx - cavw) / 28, 0, 1) * min(cavh, ctlh) * 0.3; blend: 44; show: ctlx - cavx - cavw < 28 }
            ellipse { at: (ctlx + ctlw + cenx) * 0.5, min(ctlh, cenh) * 0.5; radius: 6 + clamp(1 - (cenx - ctlx - ctlw) / 28, 0, 1) * min(ctlh, cenh) * 0.3; blend: 44; show: cenx - ctlx - ctlw < 28 }
            ellipse { at: (cenx + cenw + trpx) * 0.5, min(cenh, trph) * 0.5; radius: 6 + clamp(1 - (trpx - cenx - cenw) / 28, 0, 1) * min(cenh, trph) * 0.3; blend: 44; show: trpx - cenx - cenw < 28 }
            ellipse { at: (trpx + trpw + pwx) * 0.5, min(trph, pwh) * 0.5; radius: 6 + clamp(1 - (pwx - trpx - trpw) / 28, 0, 1) * min(trph, pwh) * 0.3; blend: 44; show: pwx - trpx - trpw < 28 }
            box { from: ntx, (nty + 0 * (nth + ntg)); size: ntw, nth * nn0; corner: roundness * 0.55 * nn0; blend: 22 }
            ellipse { at: ntx + ntw * (0.16 + noise(60, 3) * 0.05) + noise(60 + 1, t) * 4 * life, (nty + 0 * (nth + ntg)) + nth * nn0 - 3 + noise(60 + 2, t * 1.3) * 3 * life + nl0 * 5 * (noise(60 + 3, t) * 0.5 + 0.5); radius: (7 + nl0 * 3) * thickness * nn0 * nn0; scale: 1, 0.85 + nl0 * 0.25; blend: 14 }
            ellipse { at: ntx + ntw * (0.38 + noise(61, 3) * 0.05) + noise(61 + 1, t) * 4 * life, (nty + 0 * (nth + ntg)) + nth * nn0 - 3 + noise(61 + 2, t * 1.3) * 3 * life + nl0 * 5 * (noise(61 + 3, t) * 0.5 + 0.5); radius: (9 + nl0 * 3) * thickness * nn0 * nn0; scale: 1, 0.85 + nl0 * 0.25; blend: 14 }
            ellipse { at: ntx + ntw * (0.62 + noise(62, 3) * 0.05) + noise(62 + 1, t) * 4 * life, (nty + 0 * (nth + ntg)) + nth * nn0 - 3 + noise(62 + 2, t * 1.3) * 3 * life + nl0 * 5 * (noise(62 + 3, t) * 0.5 + 0.5); radius: (8 + nl0 * 3) * thickness * nn0 * nn0; scale: 1, 0.85 + nl0 * 0.25; blend: 14 }
            ellipse { at: ntx + ntw * (0.84 + noise(63, 3) * 0.05) + noise(63 + 1, t) * 4 * life, (nty + 0 * (nth + ntg)) + nth * nn0 - 3 + noise(63 + 2, t * 1.3) * 3 * life + nl0 * 5 * (noise(63 + 3, t) * 0.5 + 0.5); radius: (6 + nl0 * 3) * thickness * nn0 * nn0; scale: 1, 0.85 + nl0 * 0.25; blend: 14 }
            box { from: ntx, (nty + 1 * (nth + ntg)); size: ntw, nth * nn1; corner: roundness * 0.55 * nn1; blend: 22 }
            ellipse { at: ntx + ntw * (0.16 + noise(70, 3) * 0.05) + noise(70 + 1, t) * 4 * life, (nty + 1 * (nth + ntg)) + nth * nn1 - 3 + noise(70 + 2, t * 1.3) * 3 * life + nl1 * 5 * (noise(70 + 3, t) * 0.5 + 0.5); radius: (7 + nl1 * 3) * thickness * nn1 * nn1; scale: 1, 0.85 + nl1 * 0.25; blend: 14 }
            ellipse { at: ntx + ntw * (0.38 + noise(71, 3) * 0.05) + noise(71 + 1, t) * 4 * life, (nty + 1 * (nth + ntg)) + nth * nn1 - 3 + noise(71 + 2, t * 1.3) * 3 * life + nl1 * 5 * (noise(71 + 3, t) * 0.5 + 0.5); radius: (9 + nl1 * 3) * thickness * nn1 * nn1; scale: 1, 0.85 + nl1 * 0.25; blend: 14 }
            ellipse { at: ntx + ntw * (0.62 + noise(72, 3) * 0.05) + noise(72 + 1, t) * 4 * life, (nty + 1 * (nth + ntg)) + nth * nn1 - 3 + noise(72 + 2, t * 1.3) * 3 * life + nl1 * 5 * (noise(72 + 3, t) * 0.5 + 0.5); radius: (8 + nl1 * 3) * thickness * nn1 * nn1; scale: 1, 0.85 + nl1 * 0.25; blend: 14 }
            ellipse { at: ntx + ntw * (0.84 + noise(73, 3) * 0.05) + noise(73 + 1, t) * 4 * life, (nty + 1 * (nth + ntg)) + nth * nn1 - 3 + noise(73 + 2, t * 1.3) * 3 * life + nl1 * 5 * (noise(73 + 3, t) * 0.5 + 0.5); radius: (6 + nl1 * 3) * thickness * nn1 * nn1; scale: 1, 0.85 + nl1 * 0.25; blend: 14 }
            box { from: ntx, (nty + 2 * (nth + ntg)); size: ntw, nth * nn2; corner: roundness * 0.55 * nn2; blend: 22 }
            ellipse { at: ntx + ntw * (0.16 + noise(80, 3) * 0.05) + noise(80 + 1, t) * 4 * life, (nty + 2 * (nth + ntg)) + nth * nn2 - 3 + noise(80 + 2, t * 1.3) * 3 * life + nl2 * 5 * (noise(80 + 3, t) * 0.5 + 0.5); radius: (7 + nl2 * 3) * thickness * nn2 * nn2; scale: 1, 0.85 + nl2 * 0.25; blend: 14 }
            ellipse { at: ntx + ntw * (0.38 + noise(81, 3) * 0.05) + noise(81 + 1, t) * 4 * life, (nty + 2 * (nth + ntg)) + nth * nn2 - 3 + noise(81 + 2, t * 1.3) * 3 * life + nl2 * 5 * (noise(81 + 3, t) * 0.5 + 0.5); radius: (9 + nl2 * 3) * thickness * nn2 * nn2; scale: 1, 0.85 + nl2 * 0.25; blend: 14 }
            ellipse { at: ntx + ntw * (0.62 + noise(82, 3) * 0.05) + noise(82 + 1, t) * 4 * life, (nty + 2 * (nth + ntg)) + nth * nn2 - 3 + noise(82 + 2, t * 1.3) * 3 * life + nl2 * 5 * (noise(82 + 3, t) * 0.5 + 0.5); radius: (8 + nl2 * 3) * thickness * nn2 * nn2; scale: 1, 0.85 + nl2 * 0.25; blend: 14 }
            ellipse { at: ntx + ntw * (0.84 + noise(83, 3) * 0.05) + noise(83 + 1, t) * 4 * life, (nty + 2 * (nth + ntg)) + nth * nn2 - 3 + noise(83 + 2, t * 1.3) * 3 * life + nl2 * 5 * (noise(83 + 3, t) * 0.5 + 0.5); radius: (6 + nl2 * 3) * thickness * nn2 * nn2; scale: 1, 0.85 + nl2 * 0.25; blend: 14 }
            ellipse { at: ntx + ntw * 0.5, nty - 10; radius: nn0 * 16; scale: 1.6, 1; blend: 44 }
            ellipse { at: nbx, nby; radius: if(nunread > 0, 8 + min(nunread, 9) * 0.6, 0); blend: 16 }
        }
        // Warm light and tiny trapped bubbles drifting inside the mass.
        ellipse { at: cavx + cavw * 0.17 + noise(21, t) * 3 * life, 12 + noise(22, t) * 2 * life; radius: 3; color: gold; opacity: 0.45; show: cavaon }
        ellipse { at: cavx + cavw * 0.80 + noise(23, t) * 3 * life, 19 + noise(24, t) * 2 * life; radius: 2; color: gold; opacity: 0.35; show: cavaon }
        ellipse { at: ctlx + ctlw * 0.17 + noise(21, t) * 3 * life, 12 + noise(22, t) * 2 * life; radius: 3; color: gold; opacity: 0.45; show: controlson }
        ellipse { at: ctlx + ctlw * 0.80 + noise(23, t) * 3 * life, 19 + noise(24, t) * 2 * life; radius: 2; color: gold; opacity: 0.35; show: controlson }
        ellipse { at: cenx + cenw * 0.17 + noise(21, t) * 3 * life, 12 + noise(22, t) * 2 * life; radius: 3; color: gold; opacity: 0.45; show: true }
        ellipse { at: cenx + cenw * 0.80 + noise(23, t) * 3 * life, 19 + noise(24, t) * 2 * life; radius: 2; color: gold; opacity: 0.35; show: true }
        ellipse { at: trpx + trpw * 0.17 + noise(21, t) * 3 * life, 12 + noise(22, t) * 2 * life; radius: 3; color: gold; opacity: 0.45; show: trayon }
        ellipse { at: trpx + trpw * 0.80 + noise(23, t) * 3 * life, 19 + noise(24, t) * 2 * life; radius: 2; color: gold; opacity: 0.35; show: trayon }
        ellipse { at: pwx + pww * 0.17 + noise(21, t) * 3 * life, 12 + noise(22, t) * 2 * life; radius: 3; color: gold; opacity: 0.45; show: poweron }
        ellipse { at: pwx + pww * 0.80 + noise(23, t) * 3 * life, 19 + noise(24, t) * 2 * life; radius: 2; color: gold; opacity: 0.35; show: poweron }
    }

    // A small living blob: buttons, rows, search field. `hot` is hover (0..1),
    // `armed` is 0/1 for the selected/confirming state. No glass: glass inside
    // glass is heavy and unreadable, so these are plain tinted honey. Built from
    // a pill plus two drifting lumps; closed paths are far too slow in lists.
    component Gob(x: number, y: number, w: number, h: number, hot: number = 0, armed: number = 0, seed: number = 0) {
        let t = time * 0.5 + seed * 3.7
        let wob = min(h * 0.22, 7) * life
        body {
            color: if(armed > 0, orange, gold); opacity: 0.14 + hot * 0.22 + armed * 0.62
            rim: 8.000%; light: 0.25, 0.1, 0.7
            shadow: 0, 1, 3, 0.15
            box { from: x, y + 1; size: w, h - 2; corner: h * 0.5 }
            ellipse { at: x + w * (0.33 + noise(seed + 1, t) * 0.1), y + h * 0.5 + noise(seed + 2, t) * wob; radius: h * 0.5 + 1 + abs(noise(seed + 3, t)) * wob * 0.6; scale: 1.7, 1; blend: 8 }
            ellipse { at: x + w * (0.67 + noise(seed + 4, t) * 0.1), y + h * 0.5 + noise(seed + 5, t) * wob; radius: h * 0.5 + 1 + abs(noise(seed + 6, t)) * wob * 0.6; scale: 1.7, 1; blend: 8 }
            ellipse { at: x + w * (0.3 + noise(seed + 9, t) * 0.1), y + h + 1 + hot * 2; radius: hot * 3.5 + armed * 2; blend: 7; show: hot + armed > 0.12 }
        }
    }

    // A wallpaper as a honeycomb cell: a rounded hexagon of honey (three rotated
    // boxes, no path) holding the picture clipped to a smaller hexagon. It drips
    // from its lower vertex on hover and, once chosen, sags and runs down.
    component HexWall(cx: number, cy: number, r: number, w: record) {
        zone ellipse hit { at: cx, cy; radius: r * 0.9; cursor: pointer }
        prop pk = 0 ~drip
        follow pk = if(wallpick == w.index, 1, 0)
        prop hot = 0 ~droplet
        follow hot = hit.hover
        let t = time * 0.6 + w.index * 1.7
        body {
            color: if(w.current, orange, honey); opacity: 0.94
            rim: 8.000%; light: 0.25, 0.15, 0.7
            shadow: 0, 3 + hot * 3, 8 + hot * 6, 0.25
            box { at: cx, cy; size: r * 1.732, r; corner: 8; rotate: 0deg }
            box { at: cx, cy; size: r * 1.732, r; corner: 8; rotate: 60deg }
            box { at: cx, cy; size: r * 1.732, r; corner: 8; rotate: 120deg }
            ellipse { at: cx, cy + r * 0.45 + pk * r * 0.35; radius: r * 0.5 * pk; scale: 1.5, 1; blend: 20; show: pk > 0.02 }
            ellipse { at: cx + noise(w.index, t) * 2 * life, cy + r * 0.9 + hot * 10 + pk * r; radius: 1 + hot * 6 + pk * 9; scale: 1, 1 + hot * 0.8 + pk * 1.8; blend: 12; show: hot + pk > 0.03 }
            ellipse { at: cx - r * 0.8, cy + r * 0.5 + hot * 4 + pk * r * 0.6; radius: hot * 3.5 + pk * 6; scale: 1, 1 + pk * 1.2; blend: 10; show: hot + pk > 0.1 }
            ellipse { at: cx + r * 0.8, cy + r * 0.5 + pk * r * 0.45; radius: pk * 5; scale: 1, 1 + pk; blend: 10; show: pk > 0.1 }
        }
        group {
            opacity: 1 - pk * 0.3
            clip box { at: cx, cy; size: r * 2.2, (r - 6) * 1.732; corner: 4; rotate: 90deg }
            clip box { at: cx, cy; size: r * 2.2, (r - 6) * 1.732; corner: 4; rotate: 150deg }
            clip box { at: cx, cy; size: r * 2.2, (r - 6) * 1.732; corner: 4; rotate: 210deg }
            image w.thumb { at: cx - r * 1.78, cy - r + pk * r * 0.2 + hot * 2; size: r * 3.56, r * 2 }
        }
        text w.name { family: "Nunito"; anchor: center; at: cx, cy + r * 0.62; size: 11; weight: 700; width: r * 1.4; lines: 1; color: ink; opacity: hot; shadow: 0, 1, 3, 0.8 }
        on press hit { emit wall_pick(w.index) }
    }

    // Honey slider: the fill is a body whose end is a droplet that lags behind
    // the value (viscous spring) and stretches with its own speed.
    component Fluid(x: number, y: number, w: number, v: number, on: number = 1, seed: number = 0) {
        prop pv = 0 ~viscous
        follow pv = v
        let stretch = 1 + min(abs(vel(pv)) * 0.8, 0.7) * deform
        let t = time * 0.6 + seed
        Gob(x, y - 2, w, 13, 0, 0, seed + 40)
        body {
            color: orange; opacity: 0.9 * on
            rim: 8.000%; light: 0.3, 0.1, 0.7
            shadow: 0, 1, 3, 0.2
            box { from: x, y; size: max(2, w * pv), 9; corner: 4 }
            ellipse { at: x + w * pv, y + 4.5 + noise(seed, t) * life; radius: 8; scale: stretch, 1 + noise(seed + 1, t) * 0.08 * life; blend: 12 }
        }
    }
}
